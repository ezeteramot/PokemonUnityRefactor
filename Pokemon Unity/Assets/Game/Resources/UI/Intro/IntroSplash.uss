.intro-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: #000000;
    flex-direction: column;
}

.intro-splash {
    width: 80vw;
    height: 45vw;
    max-width: 90%;
    max-height: 80%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.intro-start-prompt {
    width: 30vw;
    height: 10vw;
    max-width: 40%;
    max-height: 20%;
    margin-top: 32px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
